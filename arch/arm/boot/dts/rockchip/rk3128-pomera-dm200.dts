/dts-v1/;

#include "rk3128.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/pwm/pwm.h>

/ {
	model = "King Jim Pomera DM200";
	compatible = "kingjim,pomera-dm200", "rockchip,rk3128";

	aliases {
		mmc0 = &emmc;
		mmc1 = &sdmmc;
	};

	chosen {
		stdout-path = &uart1;
	};

	memory@60000000 {
		device_type = "memory";
		reg = <0x60000000 0x20000000>;
	};

	wifi_vcc: wifi-vcc {
		compatible = "regulator-fixed";
		gpio = <&gpio0 RK_PD6 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_power>;
		regulator-name = "wifi-vcc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <20000>;
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_reset>;
		reset-gpios = <&gpio3 RK_PD3 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <200>;
		power-off-delay-us = <200>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		brightness-levels = <0 255>;
		num-interpolated-steps = <255>;
		default-brightness-level = <128>;
		enable-gpios = <&gpio0 RK_PD3 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&backlight_enable>;
		pwms = <&pwm0 0 25000 PWM_POLARITY_INVERTED>;
	};

	battery: battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion";
		charge-full-design-microamp-hours = <4200000>;
		voltage-min-design-microvolt = <3350000>;
		voltage-max-design-microvolt = <4200000>;
		constant-charge-current-max-microamp = <1000000>;
		constant-charge-voltage-max-microvolt = <4250000>;
		ocv-capacity-celsius = <20>;
		ocv-capacity-table-0 =
			<4174000 100>, <4123000 95>, <4087000 90>,
			<4033000 85>, <3978000 80>, <3958000 75>,
			<3933000 70>, <3907000 65>, <3881000 60>,
			<3839000 55>, <3812000 50>, <3796000 45>,
			<3785000 40>, <3778000 35>, <3775000 30>,
			<3770000 25>, <3752000 20>, <3719000 15>,
			<3693000 10>, <3677000 5>, <3350000 0>;
	};

	panel {
		compatible = "panel-lvds";
		backlight = <&backlight>;
		data-mapping = "jeida-18";
		enable-gpios = <&gpio0 RK_PD0 GPIO_ACTIVE_HIGH>;
		height-mm = <90>;
		pinctrl-names = "default";
		pinctrl-0 = <&panel_enable>;
		width-mm = <154>;

		panel-timing {
			clock-frequency = <51200000>;
			hactive = <1024>;
			vactive = <600>;
			hback-porch = <100>;
			hfront-porch = <210>;
			hsync-len = <10>;
			vback-porch = <8>;
			vfront-porch = <25>;
			vsync-len = <2>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <0>;
			pixelclk-active = <0>;
		};

		port {
			panel_in_lvds: endpoint {
				remote-endpoint = <&lvds_out_panel>;
			};
		};
	};

	keyboard-modifiers {
		compatible = "gpio-keys";
		autorepeat;
		pinctrl-names = "default";
		pinctrl-0 = <&keyboard_modifier_pins>;

		left-alt {
			label = "Left Alt";
			linux,code = <KEY_LEFTALT>;
			gpios = <&gpio0 RK_PB5 GPIO_ACTIVE_LOW>;
		};

		left-control {
			label = "Left Control";
			linux,code = <KEY_LEFTCTRL>;
			gpios = <&gpio0 RK_PB6 GPIO_ACTIVE_LOW>;
		};

		left-shift {
			label = "Left Shift";
			linux,code = <KEY_LEFTSHIFT>;
			gpios = <&gpio0 RK_PB7 GPIO_ACTIVE_LOW>;
		};

		right-shift {
			label = "Right Shift";
			linux,code = <KEY_RIGHTSHIFT>;
			gpios = <&gpio0 RK_PB4 GPIO_ACTIVE_LOW>;
		};
	};
};

&cpu0 {
	cpu-supply = <&vdd_arm>;
};

&display_subsystem {
	status = "okay";
};

&dphy {
	status = "okay";
};

&emmc {
	bus-width = <8>;
	cap-mmc-highspeed;
	max-frequency = <50000000>;
	mmc-ddr-3_3v;
	no-sd;
	no-sdio;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_clk &emmc_cmd &emmc_bus8>;
	status = "okay";
};

&gpu {
	mali-supply = <&vdd_logic>;
};

&i2c0 {
	status = "okay";

	keyboard@45 {
		compatible = "toshiba,tc35894";
		reg = <0x45>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA7 IRQ_TYPE_EDGE_FALLING>;
		interrupt-controller;
		#interrupt-cells = <1>;
		reset-gpios = <&gpio0 RK_PD1 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&tc35894_irq>, <&tc35894_reset>;
		wakeup-source;

		keypad {
			compatible = "toshiba,tc3589x-keypad";
			interrupts = <6>;
			keypad,num-columns = <12>;
			keypad,num-rows = <8>;
			wakeup-source;
			linux,keymap =
				<MATRIX_KEY(7, 0, KEY_ESC)>,
				<MATRIX_KEY(6, 0, KEY_GRAVE)>,
				<MATRIX_KEY(5, 0, KEY_F1)>,
				<MATRIX_KEY(4, 0, KEY_F2)>,
				<MATRIX_KEY(7, 2, KEY_F3)>,
				<MATRIX_KEY(7, 6, KEY_F4)>,
				<MATRIX_KEY(7, 9, KEY_F5)>,
				<MATRIX_KEY(6, 9, KEY_F6)>,
				<MATRIX_KEY(2, 8, KEY_F7)>,
				<MATRIX_KEY(1, 8, KEY_F8)>,
				<MATRIX_KEY(0, 8, KEY_F9)>,
				<MATRIX_KEY(3, 7, KEY_F10)>,
				<MATRIX_KEY(2, 7, KEY_INSERT)>,
				<MATRIX_KEY(1, 7, KEY_DELETE)>,
				<MATRIX_KEY(3, 0, KEY_1)>,
				<MATRIX_KEY(2, 0, KEY_2)>,
				<MATRIX_KEY(7, 1, KEY_3)>,
				<MATRIX_KEY(6, 2, KEY_4)>,
				<MATRIX_KEY(6, 6, KEY_5)>,
				<MATRIX_KEY(5, 6, KEY_6)>,
				<MATRIX_KEY(5, 9, KEY_7)>,
				<MATRIX_KEY(3, 8, KEY_8)>,
				<MATRIX_KEY(4, 7, KEY_9)>,
				<MATRIX_KEY(4, 5, KEY_0)>,
				<MATRIX_KEY(3, 5, KEY_MINUS)>,
				<MATRIX_KEY(2, 5, KEY_EQUAL)>,
				<MATRIX_KEY(1, 5, KEY_YEN)>,
				<MATRIX_KEY(2, 4, KEY_BACKSPACE)>,
				<MATRIX_KEY(1, 0, KEY_TAB)>,
				<MATRIX_KEY(6, 1, KEY_Q)>,
				<MATRIX_KEY(5, 1, KEY_W)>,
				<MATRIX_KEY(5, 2, KEY_E)>,
				<MATRIX_KEY(4, 2, KEY_R)>,
				<MATRIX_KEY(4, 6, KEY_T)>,
				<MATRIX_KEY(3, 6, KEY_Y)>,
				<MATRIX_KEY(4, 9, KEY_U)>,
				<MATRIX_KEY(4, 8, KEY_I)>,
				<MATRIX_KEY(5, 7, KEY_O)>,
				<MATRIX_KEY(6, 5, KEY_P)>,
				<MATRIX_KEY(5, 5, KEY_LEFTBRACE)>,
				<MATRIX_KEY(3, 4, KEY_RIGHTBRACE)>,
				<MATRIX_KEY(5, 3, KEY_ENTER)>,
				<MATRIX_KEY(0, 0, KEY_CAPSLOCK)>,
				<MATRIX_KEY(4, 1, KEY_A)>,
				<MATRIX_KEY(3, 1, KEY_S)>,
				<MATRIX_KEY(3, 2, KEY_D)>,
				<MATRIX_KEY(2, 2, KEY_F)>,
				<MATRIX_KEY(2, 6, KEY_G)>,
				<MATRIX_KEY(3, 9, KEY_H)>,
				<MATRIX_KEY(5, 8, KEY_J)>,
				<MATRIX_KEY(6, 7, KEY_K)>,
				<MATRIX_KEY(7, 5, KEY_L)>,
				<MATRIX_KEY(4, 4, KEY_SEMICOLON)>,
				<MATRIX_KEY(7, 3, KEY_APOSTROPHE)>,
				<MATRIX_KEY(6, 3, KEY_BACKSLASH)>,
				<MATRIX_KEY(2, 1, KEY_Z)>,
				<MATRIX_KEY(1, 1, KEY_X)>,
				<MATRIX_KEY(1, 2, KEY_C)>,
				<MATRIX_KEY(0, 2, KEY_V)>,
				<MATRIX_KEY(1, 6, KEY_B)>,
				<MATRIX_KEY(2, 9, KEY_N)>,
				<MATRIX_KEY(6, 8, KEY_M)>,
				<MATRIX_KEY(7, 7, KEY_COMMA)>,
				<MATRIX_KEY(6, 4, KEY_DOT)>,
				<MATRIX_KEY(5, 4, KEY_SLASH)>,
				<MATRIX_KEY(4, 3, KEY_RO)>,
				<MATRIX_KEY(3, 3, KEY_UP)>,
				<MATRIX_KEY(0, 4, KEY_LEFTMETA)>,
				<MATRIX_KEY(0, 1, KEY_MUHENKAN)>,
				<MATRIX_KEY(0, 6, KEY_SPACE)>,
				<MATRIX_KEY(7, 8, KEY_HENKAN)>,
				<MATRIX_KEY(7, 4, KEY_KATAKANAHIRAGANA)>,
				<MATRIX_KEY(2, 3, KEY_LEFT)>,
				<MATRIX_KEY(1, 3, KEY_DOWN)>,
				<MATRIX_KEY(0, 3, KEY_RIGHT)>;
		};
	};

	rk818: pmic@1c {
		compatible = "rockchip,rk818";
		reg = <0x1c>;
		interrupt-parent = <&gpio1>;
		interrupts = <RK_PB1 IRQ_TYPE_LEVEL_LOW>;
		system-power-controller;
		wakeup-source;
		#clock-cells = <1>;

		charger {
			monitored-battery = <&battery>;
		};

		regulators {
			vdd_arm: DCDC_REG1 {
				regulator-name = "vdd_arm";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1500000>;
			};

			vdd_logic: DCDC_REG2 {
				regulator-name = "vdd_logic";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1500000>;
			};

			vcc_ddr: DCDC_REG3 {
				regulator-name = "vcc_ddr";
				regulator-always-on;
				regulator-boot-on;
			};

			vccio: DCDC_REG4 {
				regulator-name = "vccio";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
			};

			vcc_ldo1: LDO_REG1 {
				regulator-name = "rk818_ldo1";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};

			vcc_ldo2: LDO_REG2 {
				regulator-name = "rk818_ldo2";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
			};

			vcc_ldo3: LDO_REG3 {
				regulator-name = "rk818_ldo3";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
			};

			vcc_ldo4: LDO_REG4 {
				regulator-name = "rk818_ldo4";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
			};

			vcc_ldo5: LDO_REG5 {
				regulator-name = "rk818_ldo5";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
			};

			vcc_ldo6: LDO_REG6 {
				regulator-name = "rk818_ldo6";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
			};

			vcc_ldo7: LDO_REG7 {
				regulator-name = "rk818_ldo7";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			vcc_ldo8: LDO_REG8 {
				regulator-name = "rk818_ldo8";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};

			vcc_sd: LDO_REG9 {
				regulator-name = "vcc_sd";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3000000>;
			};

			vcc_switch: SWITCH_REG {
				regulator-name = "rk818_ldo10";
				regulator-always-on;
				regulator-boot-on;
			};
		};
	};
};

&lvds {
	status = "okay";

	ports {
		port@1 {
			lvds_out_panel: endpoint {
				remote-endpoint = <&panel_in_lvds>;
			};
		};
	};
};

&pinctrl {
	pcfg_output_low: pcfg-output-low {
		bias-disable;
		output-low;
	};

	pcfg_pull_up: pcfg-pull-up {
		bias-pull-up;
	};

	pmic {
		pmic_int: pmic-int {
			rockchip,pins = <1 RK_PB1 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	keyboard {
		keyboard_modifier_pins: keyboard-modifier-pins {
			rockchip,pins =
				<0 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PB7 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		tc35894_irq: tc35894-irq {
			rockchip,pins = <0 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		tc35894_reset: tc35894-reset {
			rockchip,pins = <0 RK_PD1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	display {
		backlight_enable: backlight-enable {
			rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_output_low>;
		};

		panel_enable: panel-enable {
			rockchip,pins = <0 RK_PD0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	wireless {
		wifi_power: wifi-power {
			rockchip,pins = <0 RK_PD6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		wifi_host_wake: wifi-host-wake {
			rockchip,pins = <3 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		wifi_reset: wifi-reset {
			rockchip,pins = <3 RK_PD3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&pwm0 {
	status = "okay";
};

&sdmmc {
	broken-cd;
	bus-width = <4>;
	cap-sd-highspeed;
	max-frequency = <37500000>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_clk &sdmmc_cmd &sdmmc_bus4>;
	vmmc-supply = <&vcc_sd>;
	status = "okay";
};

&sdio {
	bus-width = <4>;
	cap-sdio-irq;
	keep-power-in-suspend;
	mmc-pwrseq = <&wifi_pwrseq>;
	vmmc-supply = <&wifi_vcc>;
	max-frequency = <50000000>;
	non-removable;
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdio_clk &sdio_cmd &sdio_bus4>;
	status = "okay";

	wifi@1 {
		compatible = "brcm,bcm43362-fmac", "brcm,bcm4329-fmac";
		reg = <1>;
		interrupt-parent = <&gpio3>;
		interrupts = <RK_PC7 IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "host-wake";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_host_wake>;
		brcm,ccode-map-trivial;
	};
};

&uart1 {
	status = "okay";
};

/* The DM200 Bluetooth controller is attached to UART0. */
&uart0 {
	status = "okay";
	/* Match the vendor tree: Bluetooth uses PIO at 115200 baud. */
	dma-names = "!tx", "!rx";
	pinctrl-0 = <&uart0_xfer &uart0_cts &uart0_rts>;
	uart-has-rtscts;

	bluetooth {
		compatible = "brcm,bcm20702a1";
		device-wakeup-gpios = <&gpio3 RK_PD2 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio3 RK_PC5 GPIO_ACTIVE_LOW>;
		interrupt-parent = <&gpio3>;
		interrupts = <RK_PC6 IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "host-wakeup";
	};
};

&vop {
	status = "okay";
};
