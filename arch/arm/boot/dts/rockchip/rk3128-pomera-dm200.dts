/dts-v1/;

#include "rk3128.dtsi"

/ {
	model = "King Jim Pomera DM200";
	compatible = "kingjim,pomera-dm200", "rockchip,rk3128";

	aliases {
		mmc0 = &emmc;
		mmc1 = &sdmmc;
	};

	chosen {
		stdout-path = &uart1;
	};

	memory@60000000 {
		device_type = "memory";
		reg = <0x60000000 0x20000000>;
	};
};

&cpu0 {
	cpu-supply = <&vdd_arm>;
};

&emmc {
	bus-width = <8>;
	cap-mmc-highspeed;
	max-frequency = <50000000>;
	mmc-ddr-3_3v;
	no-sd;
	no-sdio;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_clk &emmc_cmd &emmc_bus8>;
	status = "okay";
};

&gpu {
	mali-supply = <&vdd_logic>;
};

&i2c0 {
	status = "okay";

	rk818: pmic@1c {
		compatible = "rockchip,rk818";
		reg = <0x1c>;
		interrupt-parent = <&gpio1>;
		interrupts = <RK_PB1 IRQ_TYPE_LEVEL_LOW>;
		system-power-controller;
		wakeup-source;
		#clock-cells = <1>;

		regulators {
			vdd_arm: DCDC_REG1 {
				regulator-name = "vdd_arm";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1500000>;
			};

			vdd_logic: DCDC_REG2 {
				regulator-name = "vdd_logic";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1500000>;
			};

			vcc_ddr: DCDC_REG3 {
				regulator-name = "vcc_ddr";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
			};

			vccio: DCDC_REG4 {
				regulator-name = "vccio";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
			};

			vcc_ldo1: LDO_REG1 {
				regulator-name = "rk818_ldo1";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};

			vcc_ldo2: LDO_REG2 {
				regulator-name = "rk818_ldo2";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
			};

			vcc_ldo3: LDO_REG3 {
				regulator-name = "rk818_ldo3";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
			};

			vcc_ldo4: LDO_REG4 {
				regulator-name = "rk818_ldo4";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
			};

			vcc_ldo5: LDO_REG5 {
				regulator-name = "rk818_ldo5";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
			};

			vcc_ldo6: LDO_REG6 {
				regulator-name = "rk818_ldo6";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
			};

			vcc_ldo7: LDO_REG7 {
				regulator-name = "rk818_ldo7";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			vcc_ldo8: LDO_REG8 {
				regulator-name = "rk818_ldo8";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};

			vcc_sd: LDO_REG9 {
				regulator-name = "vcc_sd";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3000000>;
			};

			vcc_switch: SWITCH_REG {
				regulator-name = "rk818_ldo10";
				regulator-always-on;
				regulator-boot-on;
			};
		};
	};
};

&pinctrl {
	pcfg_pull_up: pcfg-pull-up {
		bias-pull-up;
	};

	pmic {
		pmic_int: pmic-int {
			rockchip,pins = <1 RK_PB1 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

&sdmmc {
	broken-cd;
	bus-width = <4>;
	cap-sd-highspeed;
	max-frequency = <37500000>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_clk &sdmmc_cmd &sdmmc_bus4>;
	vmmc-supply = <&vcc_sd>;
	status = "okay";
};

/*
 * The on-board Broadcom Wi-Fi device is attached here.  Keep the bus
 * disabled until its shared Wi-Fi/Bluetooth power sequencing is described.
 */
&sdio {
	bus-width = <4>;
	cap-sdio-irq;
	keep-power-in-suspend;
	max-frequency = <50000000>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdio_clk &sdio_cmd &sdio_bus4>;
	status = "disabled";
};

&uart1 {
	status = "okay";
};
